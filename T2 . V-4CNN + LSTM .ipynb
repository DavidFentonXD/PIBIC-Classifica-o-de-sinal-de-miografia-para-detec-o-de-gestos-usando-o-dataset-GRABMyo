    print(f'  {i:2d} {nome:<6}: {n} amostras')

# ── ARQUITETURA CNN 1D — Figura 1 do artigo ──────────────────
def build_cnn1d(input_shape=(WIN_SIZE, N_CANAIS), n_classes=N_CLASSES, lr=LR):
    """
    CNN 1D pura — Figura 1 do artigo SBCAS 2026.
    Hiperparâmetros escolhidos pelo grid search (Tabela 2):
      filtros=64, kernel=9, dropout=0.3, otimizador=AdamW
    """
    inp = layers.Input(shape=input_shape, name='Entrada_EMG')

    # Feature Extraction Block 1: Conv1D(64, k=9)
    x = layers.Conv1D(64, 9, padding='same', use_bias=False, name='Conv1_Block1')(inp)
    x = layers.BatchNormalization(name='BN1_Block1')(x)
    x = layers.Activation('relu', name='Act1_Block1')(x)
    x = layers.MaxPooling1D(2, name='Pool1_Block1')(x)
    x = layers.Dropout(0.3, name='Drop1_Block1')(x)

    # Feature Extraction Block 2: Conv1D(128, k=3)
    x = layers.Conv1D(128, 3, padding='same', use_bias=False, name='Conv1_Block2')(x)
    x = layers.BatchNormalization(name='BN1_Block2')(x)
    x = layers.Activation('relu', name='Act1_Block2')(x)
    x = layers.MaxPooling1D(2, name='Pool1_Block2')(x)
    x = layers.Dropout(0.3, name='Drop1_Block2')(x)

    # Global Average Pooling
    x = layers.GlobalAveragePooling1D(name='GlobalAvgPool')(x)

    # Fully Connected — Dense(256)
    x = layers.Dense(256, use_bias=False, name='Dense1')(x)
    x = layers.BatchNormalization(name='BN_Dense1')(x)
    x = layers.Activation('relu', name='Act_Dense1')(x)
    x = layers.Dropout(0.3, name='Drop_Dense1')(x)

    # Softmax(17)
    out = layers.Dense(n_classes, activation='softmax', name='Saida')(x)

    model = Model(inputs=inp, outputs=out, name='CNN_1D_EMG')
    model.compile(
        optimizer=optimizers.AdamW(learning_rate=lr),
        loss='categorical_crossentropy',
        metrics=['accuracy']
    )
    return model

# Exibe arquitetura
_m = build_cnn1d()
print(f'\nParâmetros totais: {_m.count_params():,}')
_m.summary(line_length=80)
del _m; gc.collect()

# ── MÉTRICAS AUXILIARES ──────────────────────────────────────
def calcular_sens_espec(cm_mat):
    n = cm_mat.shape[0]
    sens, espec = np.zeros(n), np.zeros(n)
    for k in range(n):
        TP = cm_mat[k, k]
        FN = cm_mat[k, :].sum() - TP
        FP = cm_mat[:, k].sum() - TP
        TN = cm_mat.sum() - (TP + FN + FP)
        sens[k]  = TP / (TP + FN) if (TP + FN) > 0 else 0.0
        espec[k] = TN / (TN + FP) if (TN + FP) > 0 else 0.0
    return sens, espec

def calcular_auc(y_true, y_prob, n_classes):
    cls   = np.unique(y_true)
    if len(cls) < 2: return float('nan')
    y_bin = label_binarize(y_true, classes=np.arange(n_classes))
    try:
        return roc_auc_score(y_bin[:, cls], y_prob[:, cls],
                             multi_class='ovr', average='macro')
    except Exception:
        return float('nan')

def calcular_entropia(probs):
    probs = np.clip(probs, 1e-10, 1.0)
    ent   = scipy_entropy(probs, axis=1, base=2)
    return float(np.mean(ent[np.isfinite(ent)]))

# ── K-FOLD CROSS VALIDATION ──────────────────────────────────
print(f'\n{"="*60}')
print(f'CNN 1D | {N_FOLDS} folds | {EPOCHS} épocas máx | batch={BATCH_SIZE}')
print(f'{"="*60}')

skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=42)
resultados_fold = []
histories_fold  = []
all_y_true, all_y_pred, all_y_prob = [], [], []

for fold, (tr_idx, va_idx) in enumerate(skf.split(X_all, y_all), start=1):
    print(f'\n{"="*20} Fold {fold}/{N_FOLDS} {"="*20}')
    print(f'  Treino: {len(tr_idx)} | Validação: {len(va_idx)}')

    X_tr = X_all[tr_idx].astype(np.float32)
    X_va = X_all[va_idx].astype(np.float32)
    y_tr = y_all[tr_idx]
    y_va = y_all[va_idx]

    tf.keras.backend.clear_session()
    gc.collect()

    model = build_cnn1d()

    ckpt_path = os.path.join(DIR_SAIDA, f'ckpt_fold{fold}.keras')
    hist = model.fit(
        X_tr, to_categorical(y_tr, N_CLASSES),
        validation_data=(X_va, to_categorical(y_va, N_CLASSES)),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        callbacks=[
            EarlyStopping(monitor='val_loss', patience=PATIENCE_ES,
                          restore_best_weights=True, verbose=1),
            ReduceLROnPlateau(monitor='val_loss', factor=0.2,
                              patience=PATIENCE_RLR, min_lr=1e-7, verbose=1),
            ModelCheckpoint(ckpt_path, monitor='val_loss',
                            save_best_only=True, verbose=0),
        ],
        verbose=1
    )
    histories_fold.append(hist)

    # Métricas
    y_prob = model.predict(X_va, verbose=0)
    y_pred = np.argmax(y_prob, axis=1)

    acc    = accuracy_score(y_va, y_pred)
    prec_w = precision_score(y_va, y_pred, average='weighted', zero_division=0)
    rec_w  = recall_score(y_va,   y_pred, average='weighted', zero_division=0)
    f1_w   = f1_score(y_va,       y_pred, average='weighted', zero_division=0)
    f1_mac = f1_score(y_va,       y_pred, average='macro',    zero_division=0)
    auc_v  = calcular_auc(y_va, y_prob, N_CLASSES)
    y_oh   = to_categorical(y_va, N_CLASSES)
    try:    logloss = log_loss(y_oh, y_prob)
    except: logloss = float('nan')
    try:    entropia = calcular_entropia(y_prob)
    except: entropia = float('nan')
    mse  = mean_squared_error(y_va, y_pred)
    rmse = float(np.sqrt(mse))
    mae  = mean_absolute_error(y_va, y_pred)
    try:    r2 = r2_score(y_va, y_pred)
    except: r2 = float('nan')
    cm_mat = confusion_matrix(y_va, y_pred, labels=np.arange(N_CLASSES))
    sens_p, espec_p = calcular_sens_espec(cm_mat)
    sens_med  = float(np.mean(sens_p))
    espec_med = float(np.mean(espec_p))

    print(f'\n  Fold {fold} — Resultados:')
    print(f'    Acc={acc:.4f} | F1-W={f1_w:.4f} | Recall-W={rec_w:.4f} | AUC={auc_v:.4f}')
    print(f'    Sens={sens_med:.4f} | Espec={espec_med:.4f} | LogLoss={logloss:.4f}')

    resultados_fold.append({
        'fold': fold, 'accuracy': acc, 'precision_w': prec_w,
        'recall_w': rec_w, 'f1_weighted': f1_w, 'f1_macro': f1_mac,
        'auc_roc': auc_v, 'log_loss': logloss, 'sensibilidade': sens_med,
        'especificidade': espec_med, 'entropia': entropia,
        'mse': mse, 'rmse': rmse, 'mae': mae, 'r2': r2
    })

    all_y_true.extend(y_va.tolist())
    all_y_pred.extend(y_pred.tolist())
    all_y_prob.append(y_prob)

    del model, X_tr, X_va
    gc.collect()

