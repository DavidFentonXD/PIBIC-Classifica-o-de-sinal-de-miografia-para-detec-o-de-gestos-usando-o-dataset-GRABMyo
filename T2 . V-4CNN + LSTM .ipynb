# ── PRÉ-PROCESSAMENTO — seção 2.2 ────────────────────────────
def filtrar_canal(sinal_1d, fs=FS):
    """Butterworth 20-500 Hz + Notch 60 Hz."""
    if len(sinal_1d) < 13:  # mínimo para sosfiltfilt
        return sinal_1d
    nyq = fs / 2.0
    low  = 20.0  / nyq
    high = min(500.0, nyq * 0.99) / nyq
    try:
        sos = butter(4, [low, high], btype='band', output='sos')
        sinal_1d = sosfiltfilt(sos, sinal_1d)
    except Exception:
        pass
    w0 = 60.0 / nyq
    if 0.01 < w0 < 0.99:
        try:
            b_n, a_n = iirnotch(w0, Q=30)
            sinal_1d = filtfilt(b_n, a_n, sinal_1d)
        except Exception:
            pass
    return sinal_1d

def normalizar_zscore(janela):
    """Z-score por janela — seção 2.2."""
    media = janela.mean(axis=0)
    dp    = janela.std(axis=0)
    dp[dp < 1e-7] = 1.0
    return (janela - media) / dp

# ── EXTRAÇÃO DE LABEL ────────────────────────────────────────
def extrair_label(nome):
    """gestureN → N-1 (índice 0-based: gesture1=Rest=0, gesture2=LP=1...)"""
    m = re.search(r'gesture(\d+)', nome, re.IGNORECASE)
    if m is None:
        return None
    idx = int(m.group(1)) - 1   # gesture1 → 0, gesture17 → 16
    return idx if 0 <= idx < N_CLASSES else None

# ── CARREGAMENTO DE SESSÃO ───────────────────────────────────
def carregar_sessao(data_dir):
    arquivos_hea = sorted([f for f in os.listdir(data_dir) if f.endswith('.hea')])
    print(f'  Arquivos .hea: {len(arquivos_hea)}')
    X_list, y_list, erros = [], [], 0

    for i, fname in enumerate(arquivos_hea):
        nome  = os.path.splitext(fname)[0]
        label = extrair_label(nome)
        if label is None:
            erros += 1
            continue
        try:
            rec = wfdb.rdrecord(os.path.join(data_dir, nome), warn_empty=True)
            sig = getattr(rec, 'p_signal', None)
            if sig is None or sig.ndim != 2:
                erros += 1
                continue

            # Seleciona os 14 canais bipolares
            idx_validos = [c for c in CANAIS_IDX if c < sig.shape[1]]
            sinal = sig[:, idx_validos].astype(np.float32)

            # Pad se necessário
            if len(idx_validos) < N_CANAIS:
                pad = np.zeros((sinal.shape[0], N_CANAIS - len(idx_validos)), dtype=np.float32)
                sinal = np.concatenate([sinal, pad], axis=1)

            # Filtragem canal a canal
            fs_real = int(getattr(rec, 'fs', FS))
            filtrado = np.zeros_like(sinal)
            for c in range(sinal.shape[1]):
                filtrado[:, c] = filtrar_canal(sinal[:, c], fs_real)
            del sinal

            # Segmentação em janelas + Z-score
            janelas = []
            inicio  = 0
            while inicio + WIN_SIZE <= filtrado.shape[0]:
                jan = filtrado[inicio:inicio + WIN_SIZE, :]
                jan = normalizar_zscore(jan)
                janelas.append(jan.astype(np.float16))  # float16 economiza RAM
                inicio += WIN_STEP
            del filtrado

            if janelas:
                X_list.append(np.array(janelas, dtype=np.float16))
                y_list.append(np.full(len(janelas), label, dtype=np.int32))

        except Exception as e:
            erros += 1

        if (i + 1) % 1000 == 0:
            gc.collect()
            print(f'    {i+1}/{len(arquivos_hea)} processados...')

    X = np.concatenate(X_list, axis=0)
    y = np.concatenate(y_list, axis=0)
    del X_list, y_list
    gc.collect()
    print(f'  X shape: {X.shape} | y shape: {y.shape} | Erros: {erros}')
    return X, y

# ── CARREGAR TODOS OS DADOS ──────────────────────────────────
print('\nCarregando sessoes...')
